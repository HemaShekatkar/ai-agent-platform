# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Only needed for the live demo (python -m app.main). Tests do not use it.
OPENAI_API_KEY=your-openai-api-key-here

# Optional: a disposable PostgreSQL database for the integration tests in
# tests/agents/test_postgres_*.py. Unset, those tests are skipped.
# TEST_DATABASE_URL=postgresql://localhost:5432/agent_platform_test

# PostgreSQL for agent checkpoints in the demo (app/main.py run_agent).
# Defaults to postgresql://localhost:5432/agent_platform when unset.
# DATABASE_URL=postgresql://localhost:5432/agent_platform
